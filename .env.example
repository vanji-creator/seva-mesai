# Optional locally: without DATABASE_URL an embedded Postgres (PGlite) is used in ./.data
# Required on Vercel: a Neon (or any Postgres) connection string
DATABASE_URL=

# LLM (optional): any OpenAI-compatible chat endpoint. Default is Sarvam AI.
# Without a key the app runs rule-based checks only and shows an "AI offline" banner.
LLM_API_KEY=
# LLM_BASE_URL=https://api.sarvam.ai/v1
# LLM_MODEL=sarvam-105b

# Required in production: any long random string (signs the session cookie)
SESSION_SECRET=
