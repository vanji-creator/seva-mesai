{
  "name": "seva-mesai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:push": "mkdir -p .data && drizzle-kit push --force",
    "seed": "npm run db:push && tsx src/db/seed.ts",
    "typecheck": "tsc --noEmit",
    "eval:render": "tsx eval/render.ts",
    "eval": "SARVAM_SUBMIT_GAP_MS=0 tsx --env-file=.env.local eval/run.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@neondatabase/serverless": "^1.2.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "jose": "^6.2.14",
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
